# Copy to .env (which is gitignored) and fill in — OR leave SUPABASE_SERVICE_KEY
# blank: when run inside this repo, the runner falls back to reading the key from
# ../../api/social-media/config.php (local, gitignored). So on your own Mac you can
# usually run it without creating a .env at all.
SUPABASE_URL=https://gdmntnrsgfntcgqmbmtj.supabase.co
SUPABASE_SERVICE_KEY=

# Optional auto-login for baasjegezocht (skips the manual login step entirely).
# Leave blank to log in by hand once (the persistent profile then remembers you).
# NOTE: rotate this password if it was ever shared in plain text.
BAASJEGEZOCHT_EMAIL=
BAASJEGEZOCHT_PASSWORD=
