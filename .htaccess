RewriteEngine On
RewriteBase /

# Homepage renders through its SSR wrapper (index.php localizes <head> per language:
# lang/title/description/canonical/hreflang). Falls back to static index.html if the
# wrapper is unavailable.
DirectoryIndex index.php index.html

# Force the canonical host: https + www (matches <link rel="canonical"> on every page)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.hopefordogseurope.com%{REQUEST_URI} [R=301,L]

# ===== Security response headers (SEOmator: HSTS FAIL + header WARNs) =====
# Guarded so a host without mod_headers ignores them instead of 500-ing.
# HSTS without includeSubDomains on purpose: the account may have non-HTTPS
# subdomains (webmail/cpanel) we must not force. The site itself is all-HTTPS.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ===== Text compression (gzip) — SEOmator: no text compression detected =====
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml application/rss+xml
</IfModule>

# Legacy Squarespace URLs still pulling impressions -> current pages (inventory pulled
# from Search Console via scripts/gsc-pages.mjs). Patterns are generalized to cover every
# observed variant so no legacy URL 404s: hyphen AND no-hyphen numbering (geadopteerd6
# as well as geadopteerd-6), trailing /dog-name segments, and hondenblog2/<slug>.
RewriteRule ^vragen/?$ /contact.html [R=301,L,NC]
RewriteRule ^contact-1/?$ /contact.html [R=301,L,NC]
RewriteRule ^donaties/?$ /doneer.html [R=301,L,NC]
RewriteRule ^hondenblog[0-9]*(/.*)?$ /nieuws.html [R=301,L,NC]
RewriteRule ^geadopteerd(-?[0-9]+)?(/.*)?$ /honden.html [R=301,L,NC]
RewriteRule ^honden-[0-9]+(/.*)?$ /honden.html [R=301,L,NC]
RewriteRule ^sv[a-z0-9-]*/?$ /honden.html [R=301,L,NC]

# Flagship adoption page moved to a keyword-clean URL. 301 the old paths (all languages).
# These must precede the /en//de/ .html-collapse rule below so the language prefix is kept.
RewriteRule ^(en|de)/adoptie\.html$ /$1/buitenlandse-hond-adopteren [R=301,L]
RewriteRule ^adoptie\.html$ /buitenlandse-hond-adopteren [R=301,L]
RewriteRule ^(en|de)/adoptie/?$ /$1/buitenlandse-hond-adopteren [R=301,L]
RewriteRule ^adoptie/?$ /buitenlandse-hond-adopteren [R=301,L]

# Language-prefixed URLs (/en/..., /de/...): internal rewrite, not a redirect.
# The homepage renders through index.php (SSR <head> per language); the other static
# pages are rewritten to their bare .html (then to their .php wrapper below, where one
# exists). REQUEST_URI keeps the /en//de/ prefix so ssr_lang() detects the language.
RewriteRule ^(en|de)/?$ index.php [L]
RewriteRule ^(en|de)/([a-z-]+)\.html$ /$2.html [L]

# Slug detail pages: /hond/<slug> and /nieuws/<slug> (optional /en /de prefix).
# Internal rewrite to the PHP wrapper (URL bar unchanged). Two path segments, so
# these can't collide with the single-segment extension-less rule below. REQUEST_URI
# keeps the /de/ prefix, so ssr_lang() detects the language with no extra param.
# The wrapper resolves the slug (or 301s a legacy ?id= onto it) and falls back to
# the raw template on any failure.
RewriteRule ^(?:(en|de)/)?hond/([A-Za-z0-9-]+)/?$   hond.php?slug=$2 [L,QSA]
RewriteRule ^(?:(en|de)/)?nieuws/([A-Za-z0-9-]+)/?$ post.php?slug=$2 [L,QSA]
RewriteRule ^(?:(en|de)/)?ervaring/([A-Za-z0-9-]+)/?$ ervaring.php?slug=$2 [L,QSA]

# Blog posts sitemap: serve the PHP script at a clean .xml URL (internal rewrite,
# not a redirect) since Search Console's sitemap field rejects .xml.php addresses.
RewriteRule ^sitemap-posts\.xml$ sitemap-posts.xml.php [L]

# Dog listings sitemap: same clean-.xml pattern for the dynamic hond.html?id=... pages.
RewriteRule ^sitemap-dogs\.xml$ sitemap-dogs.xml.php [L]

# Adoption-stories sitemap: same clean-.xml pattern for the dynamic ervaring.html?id=... pages.
RewriteRule ^sitemap-stories\.xml$ sitemap-stories.xml.php [L]

# SSR prerender: serve the dog detail page through its PHP wrapper (internal
# rewrite, URL bar unchanged, same HTML to bots and users). Placed AFTER the
# /en//de/ collapse above so ?id=... and the language prefix survive. The wrapper
# injects real per-dog tags/content and falls back to the raw hond.html template
# on any failure (Supabase down/slow, missing id) -> worst case = today's behaviour.
RewriteRule ^hond\.html$ hond.php [L]
RewriteRule ^post\.html$ post.php [L]
RewriteRule ^honden\.html$ honden.php [L]
RewriteRule ^ervaring\.html$ ervaring.php [L]
RewriteRule ^ervaringen\.html$ ervaringen.php [L]
RewriteRule ^nieuws\.html$ nieuws.php [L]
RewriteRule ^over-ons\.html$ over-ons.php [L]
# Flagship served at its keyword-clean URL (internal rewrite; URL bar stays clean).
RewriteRule ^(?:(en|de)/)?buitenlandse-hond-adopteren/?$ adoptie.php [L,QSA]
RewriteRule ^contact\.html$ contact.php [L]
RewriteRule ^doneer\.html$ doneer.php [L]
RewriteRule ^privacy\.html$ privacy.php [L]

# Extension-less requests (e.g. /honden, /contact) for a page that exists as .html
# -> redirect there instead of 404. Skips API/admin/asset paths.
RewriteCond %{REQUEST_URI} !^/(api|beheer|db|scripts|backups|images|fonts)/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ /$1.html [R=301,L]
