RewriteEngine On
RewriteBase /

# Force the canonical host: https + www (matches <link rel="canonical"> on every page)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.hopefordogseurope.com%{REQUEST_URI} [R=301,L]

# Stale Google sitelink pointing to a page that never existed on this site
RewriteRule ^hondenblog2/?$ /nieuws.html [R=301,L,NC]

# Extension-less requests (e.g. /honden, /contact) for a page that exists as .html
# -> redirect there instead of 404. Skips API/admin/asset paths.
RewriteCond %{REQUEST_URI} !^/(api|beheer|db|scripts|backups|images|fonts)/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ /$1.html [R=301,L]
